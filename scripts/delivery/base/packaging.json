{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-lanyard",
    "name": "Lanyard",
    "sourceRepository": "https://github.com/just-every/run-lanyard",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm exec rer check --profile first-party && pnpm run verify && pnpm check:deployment-spec",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow docs/BACKUP-RESTORE.md: stop writes and scheduled work, retain exact source and private configuration, export supported D1 and FILES data, restore into empty compatible resources, re-enter private configuration and compare a fresh export before routing traffic. Preserve every applied migration name and byte."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "IDENTITY_PROVIDER",
        "VENUE_TIMEZONE",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY"
      ],
      "healthPath": "/health",
      "recovery": "Follow docs/BACKUP-RESTORE.md. Restore supported D1 and FILES data into empty resources at the same source revision; retain original owner identity and re-enter private settings. Applied migration history must remain unchanged.",
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  }
}
